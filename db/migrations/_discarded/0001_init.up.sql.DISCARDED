-- =====================================================================
-- Shipyard :: 0001_init
-- Control plane state. Postgres 16+.
--
-- Conventions
--   * every timestamp is timestamptz, stored UTC (see docs/postgres.md §1)
--   * every surrogate key is bigint GENERATED BY DEFAULT AS IDENTITY
--   * every human-typed identifier (server/project/service/env name) is citext
--   * DDL is idempotent-ish: this file runs once, in order, via golang-migrate
-- =====================================================================

CREATE EXTENSION IF NOT EXISTS citext;

-- ---------------------------------------------------------------------
-- 0. small shared helpers
-- ---------------------------------------------------------------------

-- Native enum, not CHECK. See docs/postgres.md §1 for the defence and the
-- ALTER TYPE ... ADD VALUE migration hazard. Declared first: the helper below
-- is typed on it.
CREATE TYPE deployment_status AS ENUM (
    'PENDING',      -- queued, no worker owns it
    'CLONING',      -- git checkout of commit_sha
    'BUILDING',     -- build_command
    'CONFIGURING',  -- shared/.env + unit files
    'STARTING',     -- systemctl start
    'HEALTHY',      -- health check passed, not yet promoted
    'RUNNING',      -- serving
    'FAILED'        -- terminal, reachable from any non-terminal state
);

-- Single source of truth for "is this deployment still in flight?".
-- IMMUTABLE + STRICT so it is legal inside a partial index PREDICATE.
-- Keep this list in sync with the state machine in internal/deploy/state.go.
CREATE FUNCTION deployment_status_is_terminal(s deployment_status) RETURNS boolean
LANGUAGE sql IMMUTABLE STRICT PARALLEL SAFE AS
$$ SELECT s IN ('RUNNING', 'FAILED') $$;

-- updated_at must never be set by application code; a migration or a
-- psql session that forgets it must not silently break reconciliation.
CREATE FUNCTION touch_updated_at() RETURNS trigger
LANGUAGE plpgsql AS $$
BEGIN
    NEW.updated_at := now();
    RETURN NEW;
END;
$$;

-- ---------------------------------------------------------------------
-- 1. fleet
-- ---------------------------------------------------------------------

CREATE TABLE servers (
    id          bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    -- operator handle; also what the CLI and dashboard type
    name        citext  NOT NULL,
    -- what the execution layer dials
    ssh_host    text    NOT NULL,
    ssh_user    text    NOT NULL DEFAULT 'deploy',
    ssh_port    integer NOT NULL DEFAULT 22 CHECK (ssh_port BETWEEN 1 AND 65535),
    -- where the Bash layer puts checkouts, shared/ and units on this host
    work_dir    text    NOT NULL DEFAULT '/srv/shipyard',
    -- last time we successfully talked to this host (set by the reconciler)
    last_seen_at timestamptz,
    -- soft delete only. ON DELETE RESTRICT elsewhere keeps history intact,
    -- so a hard delete of a server that has deployments is *meant* to fail.
    archived_at timestamptz,
    created_at  timestamptz NOT NULL DEFAULT now(),
    updated_at  timestamptz NOT NULL DEFAULT now(),
    CONSTRAINT servers_name_key UNIQUE (name)
);
CREATE TRIGGER servers_touch BEFORE UPDATE ON servers
    FOR EACH ROW EXECUTE FUNCTION touch_updated_at();

CREATE TABLE projects (
    id                 bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    name               citext  NOT NULL,
    repository_url     text    NOT NULL,
    default_branch     text    NOT NULL DEFAULT 'main',
    build_command      text    NOT NULL DEFAULT 'make build',
    build_context      text    NOT NULL DEFAULT '.',
    run_command        text    NOT NULL DEFAULT 'make run',
    -- rendered by Bash to <work_dir>/<project>/<deployment>/shared/.env
    shared_dir         text    NOT NULL DEFAULT 'shared',
    -- gapless per-project human-facing deployment number
    next_deployment_no integer NOT NULL DEFAULT 1 CHECK (next_deployment_no >= 1),
    created_at         timestamptz NOT NULL DEFAULT now(),
    updated_at         timestamptz NOT NULL DEFAULT now(),
    CONSTRAINT projects_name_key UNIQUE (name)
);
CREATE TRIGGER projects_touch BEFORE UPDATE ON projects
    FOR EACH ROW EXECUTE FUNCTION touch_updated_at();

CREATE TABLE environments (
    id         bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    project_id bigint  NOT NULL REFERENCES projects(id) ON DELETE RESTRICT,
    name       citext  NOT NULL,
    created_at timestamptz NOT NULL DEFAULT now(),
    updated_at timestamptz NOT NULL DEFAULT now(),
    CONSTRAINT environments_project_name_key UNIQUE (project_id, name)
);
CREATE TRIGGER environments_touch BEFORE UPDATE ON environments
    FOR EACH ROW EXECUTE FUNCTION touch_updated_at();

-- A service is a systemd unit managed by the control plane on one host.
-- observed_state is a *measurement*, not a state machine, hence CHECK not enum.
CREATE TABLE services (
    id             bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    server_id      bigint NOT NULL REFERENCES servers(id) ON DELETE CASCADE,
    name           citext NOT NULL,
    unit_name      text   NOT NULL,
    observed_state text   NOT NULL DEFAULT 'unknown'
                     CHECK (observed_state IN ('unknown', 'running', 'degraded', 'down')),
    observed_at    timestamptz,
    created_at     timestamptz NOT NULL DEFAULT now(),
    updated_at     timestamptz NOT NULL DEFAULT now(),
    CONSTRAINT services_server_name_key  UNIQUE (server_id, name),
    CONSTRAINT services_server_unit_key  UNIQUE (server_id, unit_name)
);
CREATE INDEX services_server_id_idx ON services (server_id);
CREATE TRIGGER services_touch BEFORE UPDATE ON services
    FOR EACH ROW EXECUTE FUNCTION touch_updated_at();

-- ---------------------------------------------------------------------
-- 2. deployments
-- ---------------------------------------------------------------------

CREATE TABLE deployments (
    id              bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    -- human-facing, gapless per project: "Deployment #42"
    project_id      bigint NOT NULL REFERENCES projects(id)  ON DELETE RESTRICT,
    deployment_no   integer NOT NULL CHECK (deployment_no >= 1),
    server_id       bigint NOT NULL REFERENCES servers(id)   ON DELETE RESTRICT,
    environment_id  bigint NOT NULL REFERENCES environments(id) ON DELETE RESTRICT,

    -- immutable identity: #42 means this sha on this server, forever
    commit_sha      text NOT NULL CHECK (commit_sha ~ '^[0-9a-f]{7,40}$'),

    status          deployment_status NOT NULL DEFAULT 'PENDING',
    -- true only for the one deployment that owns the (server, project) slot
    active          boolean NOT NULL DEFAULT false,
    -- guarded by CHECK: a terminal deployment can never hold a slot
    CONSTRAINT deployments_active_implies_inflight
        CHECK (NOT active OR status IN ('CLONING', 'BUILDING', 'CONFIGURING',
                                        'STARTING', 'HEALTHY', 'RUNNING')),

    -- liveness of the worker (NOT the mutex; see docs/postgres.md §3)
    worker_id       text,
    lease_expires_at timestamptz,
    heartbeat_at    timestamptz,
    attempt         integer NOT NULL DEFAULT 1 CHECK (attempt >= 1),

    error_message   text,
    -- sha256 over the sorted (name, value) pairs this run actually used
    env_fingerprint bytea,

    queued_at       timestamptz NOT NULL DEFAULT now(),
    started_at      timestamptz,
    finished_at     timestamptz,
    created_at      timestamptz NOT NULL DEFAULT now(),
    updated_at      timestamptz NOT NULL DEFAULT now(),

    CONSTRAINT deployments_project_no_key UNIQUE (project_id, deployment_no),
    -- terminal states are closed
    CONSTRAINT deployments_finished_at_consistent
        CHECK ((status IN ('RUNNING', 'FAILED')) = (finished_at IS NOT NULL))
);

-- THE index. At most one active deployment per (server, project).
-- Column order is (server_id, project_id) not (project_id, server_id) because
-- the hot read is "what is active on server X" (fleet view, reconcile, host
-- reconcile). Uniqueness is unaffected by the order.
CREATE UNIQUE INDEX deployments_one_active_per_project_server_idx
    ON deployments (server_id, project_id)
    WHERE active;

-- Project feed: keyset pagination, newest first. (created_at, id) is a total
-- order because created_at is not unique; id breaks ties deterministically.
CREATE INDEX deployments_project_feed_idx
    ON deployments (project_id, created_at DESC, id DESC);

-- Reconcile + lease reaper. Partial: contains only in-flight rows, so its size
-- is bounded by concurrent deploys, never by history. Predicate is byte-for-
-- byte the WHERE clause of the reconcile query so the planner can use it.
CREATE INDEX deployments_inflight_idx
    ON deployments (started_at)
    WHERE NOT deployment_status_is_terminal(status);

-- Work queue. Partial: bounded by queue depth. The ORDER BY matches the index
-- so the claim query is an index scan + one row fetch, O(queue depth).
CREATE INDEX deployments_pending_queue_idx
    ON deployments (queued_at, id)
    WHERE status = 'PENDING';

CREATE TRIGGER deployments_touch BEFORE UPDATE ON deployments
    FOR EACH ROW EXECUTE FUNCTION touch_updated_at();

-- which systemd units a deployment rolls out (ordered by services.name).
-- Owned by the deployment: a rollback replays exactly this set.
CREATE TABLE deployment_services (
    deployment_id bigint NOT NULL REFERENCES deployments(id) ON DELETE CASCADE,
    service_id    bigint NOT NULL REFERENCES services(id)    ON DELETE RESTRICT,
    PRIMARY KEY (deployment_id, service_id)
);
CREATE INDEX deployment_services_service_id_idx ON deployment_services (service_id);

-- ---------------------------------------------------------------------
-- 3. environment variables (write-only, encrypted at rest, snapshotted)
-- ---------------------------------------------------------------------

CREATE TABLE project_env (
    project_id     bigint NOT NULL REFERENCES projects(id) ON DELETE CASCADE,
    name           citext NOT NULL,
    -- AES-256-GCM: [12-byte nonce || ciphertext || 16-byte tag]
    value_sealed   bytea  NOT NULL,
    -- sha256 of the plaintext; lets the UI show "changed" without decrypting
    value_fingerprint bytea NOT NULL,
    created_at     timestamptz NOT NULL DEFAULT now(),
    updated_at     timestamptz NOT NULL DEFAULT now(),
    PRIMARY KEY (project_id, name),
    -- a shell variable cannot contain NUL or a newline
    CONSTRAINT project_env_name_valid CHECK (name ~ '^[A-Za-z_][A-Za-z0-9_]*$')
);
CREATE TRIGGER project_env_touch BEFORE UPDATE ON project_env
    FOR EACH ROW EXECUTE FUNCTION touch_updated_at();

-- Immutable snapshot taken inside the claim transaction. This is what makes
-- "reproduce the exact env it ran with" answerable months later.
CREATE TABLE deployment_env (
    deployment_id   bigint NOT NULL REFERENCES deployments(id) ON DELETE CASCADE,
    name            citext NOT NULL,
    value_sealed    bytea  NOT NULL,
    value_fingerprint bytea NOT NULL,
    PRIMARY KEY (deployment_id, name)
);

-- ---------------------------------------------------------------------
-- 4. build logs: monthly range partitions, bounded lines, no content index
-- ---------------------------------------------------------------------

CREATE TABLE deployment_logs (
    -- partition key. Read paths always supply a lower bound derived from the
    -- deployment's started_at, so partition pruning always applies.
    created_at    timestamptz NOT NULL,
    id            bigint GENERATED BY DEFAULT AS IDENTITY,
    deployment_id bigint NOT NULL REFERENCES deployments(id) ON DELETE CASCADE,
    stream        text   NOT NULL DEFAULT 'stdout'
                  CHECK (stream IN ('stdout', 'stderr', 'system')),
    -- hard bound: the writer truncates, this is the backstop
    message       text   NOT NULL CHECK (octet_length(message) <= 8192),
    PRIMARY KEY (created_at, id)
) PARTITION BY RANGE (created_at);

CREATE INDEX deployment_logs_deployment_idx ON deployment_logs (deployment_id, id);

-- Create a partition for a month. Idempotent.
-- NOTE: there is deliberately NO default partition. An unpartitioned month
-- fails loudly and immediately (a deploy logs one error line) instead of
-- silently accumulating in a catch-all that retention will never drop.
CREATE FUNCTION shipyard_ensure_log_partition(p_month date)
RETURNS void LANGUAGE plpgsql AS $$
DECLARE
    lo date := date_trunc('month', p_month)::date;
    hi date := (date_trunc('month', p_month) + interval '1 month')::date;
    nm text := format('deployment_logs_%s', to_char(lo, 'YYYY_MM'));
BEGIN
    IF to_regclass('public.' || nm) IS NULL THEN
        EXECUTE format(
            'CREATE TABLE public.%I PARTITION OF public.deployment_logs
                FOR VALUES FROM (%L) TO (%L)', nm, lo, hi);
    END IF;
END;
$$;

SELECT shipyard_ensure_log_partition(date_trunc('month', now())::date);
SELECT shipyard_ensure_log_partition((date_trunc('month', now()) + interval '1 month')::date);
SELECT shipyard_ensure_log_partition((date_trunc('month', now()) + interval '2 month')::date);
SELECT shipyard_ensure_log_partition((date_trunc('month', now()) + interval '3 month')::date);

-- Retention *mechanism*. The retention *window* is a database-administrator
-- policy decision; this only makes it cheap (metadata-only DROP).
CREATE FUNCTION shipyard_drop_log_partitions_before(p_cutoff date)
RETURNS TABLE (dropped text) LANGUAGE plpgsql AS $$
DECLARE r record;
BEGIN
    -- We own the naming convention (see shipyard_ensure_log_partition), so read
    -- the bound off the name rather than parsing pg_get_expr output, which is
    -- presentation-level and not a stable contract.
    FOR r IN
        SELECT c.relname
          FROM pg_class c
          JOIN pg_inherits i ON i.inhrelid = c.oid
          JOIN pg_class p ON p.oid = i.inhparent
         WHERE p.relname = 'deployment_logs'
           AND c.relname ~ '^deployment_logs_\d{4}_\d{2}$'
           AND to_date(right(c.relname, 7), 'YYYY_MM') < date_trunc('month', p_cutoff)::date
    LOOP
        EXECUTE format('DROP TABLE public.%I', r.relname);
        dropped := r.relname;
        RETURN NEXT;
    END LOOP;
END;
$$;
